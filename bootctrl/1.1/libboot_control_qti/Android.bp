cc_library {
    name: "libboot_control_jlq",
    vendor: true,
    recovery_available: true,
    shared_libs: [
        "android.hardware.boot@1.1",
        "librecovery_updater.rhode",
        "libbase",
        "libcutils",
        "liblog",
        "libz",
    ],
    static_libs: [
        "libboot_control",
        "libbootloader_message_vendor",
        "libfstab",
    ],
    owner: "jlq",
    cflags: [
        "-Wall",
        "-Werror",
    ],
    srcs: [
        "libboot_control_jlq.cpp",
    ],
    export_include_dirs: ["."],
}
